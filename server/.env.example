PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/clevtech-devhub?retryWrites=true&w=majority

# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS in production
CLIENT_URL=https://clevtechdevhub.com

# Used only by `npm run seed` to create/reset the first admin account
SEED_ADMIN_EMAIL=admin@clevtechdevhub.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
